APP_NAME="Museo Sang Bata sa Negros"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Primary Database: MySQL (XAMPP at 127.0.0.1:3306) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=museum_system
DB_USERNAME=root
DB_PASSWORD=

# ── Zero-configuration SQLite Alternative ──
# To use SQLite instead of MySQL, uncomment:
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Museum Authentication & System Settings ──
JWT_SECRET=change-this-secret-in-production
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=museum-admin-2026

# ── Museum Chatbot & Translation (Groq) ──
GROQ_CHAT_MODEL=openai/gpt-oss-120b
SITE_URL=http://localhost:8000
SITE_NAME="Museo Sang Bata sa Negros"

# ── Text-to-Speech (Groq Orpheus) ──
GROQ_API_KEY=
